# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Temporary iOS assemble dirs used by packaging helpers
ios_*

# Web is intentionally not a supported product target yet
web

# Live2D Cubism proprietary bits stay local
!packages/native_tavern_live2d_macos/macos/
!packages/native_tavern_live2d_macos/macos/**
packages/native_tavern_live2d_macos/macos/CubismCore/

# Keep spine_flutter_4_1_compat platform overlays trackable
!packages/spine_flutter_4_1_compat/android/
!packages/spine_flutter_4_1_compat/android/**
!packages/spine_flutter_4_1_compat/ios/
!packages/spine_flutter_4_1_compat/ios/**
!packages/spine_flutter_4_1_compat/linux/
!packages/spine_flutter_4_1_compat/linux/**
!packages/spine_flutter_4_1_compat/macos/
!packages/spine_flutter_4_1_compat/macos/**
!packages/spine_flutter_4_1_compat/windows/
!packages/spine_flutter_4_1_compat/windows/**

